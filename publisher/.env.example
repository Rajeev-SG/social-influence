# social-influence publisher environment — copy to .env and fill in.
# .env is gitignored; never commit real values.
#
# Brand config: each brand resolves its own accounts/sessions from these
# names ({BRAND}_ prefix, dashes -> underscores). Add a block per brand.

# Where reusable auth/session state lives (OAuth tokens, IG session, TikTok cookies, ledger).
# Keep OUTSIDE the repo.
SOCIAL_INFLUENCE_STATE_DIR=~/.social-influence

# Publish API (optional): without this token the /publish endpoint is disabled.
SOCIAL_INFLUENCE_API_TOKEN=
# Colon-separated roots the API may load bundles from (default: repo posts/)
SOCIAL_INFLUENCE_ALLOWED_ROOTS=

# --- brand: gutkitchen ---
GUTKITCHEN_IG_USERNAME=gutkitchen.uk
GUTKITCHEN_IG_PASSWORD=
GUTKITCHEN_TIKTOK_USERNAME=gutkitchen.uk
GUTKITCHEN_YOUTUBE_HANDLE=thegutkitchen
# browser used by tiktok-uploader's Selenium flow: chrome | firefox | edge
TIKTOK_BROWSER=chrome